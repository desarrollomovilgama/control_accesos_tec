# =============================================================================
# Variables de entorno - Proyecto Control de Aulas
# Apartado 7.1 del Manual de Programación Flutter (MPF)
# -----------------------------------------------------------------------------
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA debe subirse al repositorio (ver .gitignore).
# =============================================================================

# URL base del API REST del sistema
API_BASE_URL=https://api.ejemplo.com

# Web Service SAM (autenticación institucional)
SAM_WS_URL=https://sam.ejemplo.com/ws

# Tiempo de expiración del access token (en minutos)
TOKEN_TTL_MINUTES=15

# Ambiente actual: dev | staging | prod
APP_ENV=dev

# Habilita / deshabilita logs detallados
ENABLE_VERBOSE_LOGS=true
